// TutorHub — Prisma schema (Phase 5: multi-tutor)
// - Each `Tutor` is one practice; business rows are scoped with `tutorId`.
// - `User` links Google email to role TUTOR (one Tutor) or ADMIN (no Tutor).
// - Recurring schedule with materialized Session rows; absent excludes from invoice.
// - Invoice per Parent per calendar month per Tutor; UNPAID / PAID only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  TUTOR
  ADMIN
}

enum EducationLevel {
  TK // Kindergarten
  SD // Elementary school
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum SessionStatus {
  SCHEDULED
  ATTENDED
  ABSENT
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

/// One tutor practice (studio). All roster / billing data belongs to a Tutor.
model Tutor {
  id          String   @id @default(cuid())
  displayName String
  slug        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  profile       Profile?
  parents       Parent[]
  students      Student[]
  sessions      Session[]
  monthlyReports MonthlyReport[]
  invoices      Invoice[]
}

/// Sign-in identity (Google email). OAuth Account rows come in Phase 5.3.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole
  tutorId   String?
  tutor     Tutor?   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorId])
}

model Profile {
  id                String  @id @default(cuid())
  tutorId           String  @unique
  tutor             Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  studioName        String  @default("TutorHub")
  accountHolderName String?
  bankName          String?
  bankAccountNumber String?
  whatsappNumber    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parent {
  id         String  @id @default(cuid())
  tutorId    String
  tutor      Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  name       String
  salutation String
  honorific  String
  whatsapp   String?

  students Student[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorId])
}

model Student {
  id               String         @id @default(cuid())
  tutorId          String
  tutor            Tutor          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  name             String
  age              Int?
  level            EducationLevel
  feePerSession    Int
  status           StudentStatus  @default(ACTIVE)
  calendarColorKey String         @default("primary")

  parent   Parent? @relation(fields: [parentId], references: [id])
  parentId String?

  scheduleRules ScheduleRule[]
  sessions      Session[]
  reports       MonthlyReport[]
  invoiceItems  InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorId])
}

model ScheduleRule {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  dayOfWeek Int
  startTime String
  endTime   String

  startDate DateTime
  endDate   DateTime?

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String  @id @default(cuid())
  tutorId   String
  tutor     Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  scheduleRule   ScheduleRule? @relation(fields: [scheduleRuleId], references: [id])
  scheduleRuleId String?

  date      DateTime
  startTime String
  endTime   String

  status SessionStatus @default(SCHEDULED)
  notes  String?

  fee Int

  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  invoiceItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date, startTime])
  @@index([studentId, date])
  @@index([tutorId, date])
  @@index([invoiceItemId])
}

model MonthlyReport {
  id        String  @id @default(cuid())
  tutorId   String
  tutor     Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  month Int
  year  Int

  contentJson Json?

  status      ReportStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tutorId, studentId, month, year])
}

model Invoice {
  id       String @id @default(cuid())
  tutorId  String
  tutor    Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  parent   Parent @relation(fields: [parentId], references: [id])
  parentId String

  month Int
  year  Int

  status InvoiceStatus @default(UNPAID)
  paidAt DateTime?

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tutorId, parentId, month, year])
  @@index([tutorId, year, month])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  sessionCount  Int
  feePerSession Int
  subtotal      Int

  sessions Session[]

  createdAt DateTime @default(now())
}
