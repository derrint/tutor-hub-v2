# --- Auth.js (Google, two-account allowlist) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# Local: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Comma-separated Google emails allowed to sign in (exactly two for tutor + partner)
AUTH_ALLOWED_EMAILS="you@gmail.com,partner@gmail.com"

# Optional on Vercel (Auth.js usually infers from VERCEL_URL)
# AUTH_URL=https://your-app.vercel.app

# --- Neon Postgres (Phase 2) ---
# Pooled connection for the app (Neon “pooler” host)
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection for Prisma migrate
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
